<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite parallel="tests" name="Suite">
<groups>
<run>
<include name="ErrorHandling"/>
<include name="Registration"/>
</run>
</groups>
  <test thread-count="5" name="ErrorValidations">
    <classes>
      <class name="TestAutomationFramework.SeleniumFramework.Testcases.ErrorValidation"/>
      <class name="TestAutomationFramework.SeleniumFramework.Testcases.RegistrationValidation"/>
    </classes>
       </test>

    <test thread-count="5" name="EndtoEnd">
       <classes>
       <class name="TestAutomationFramework.SeleniumFramework.Testcases.EndtoEndTestCase"/>
   	</classes>

  </test> <!-- Test -->
</suite> <!-- Suite -->
